      <button
        class="btn logout"
        onclick="logout()"
      >
        Sair da conta
      </button>

    </div>


    <div class="footer">

      O Viva+ fornece informações educativas sobre hábitos
      e bem-estar. Não realiza diagnóstico ou substitui
      profissionais de saúde.

    </div>

  </div>

</div>


<script>

/*
============================================================
CONFIGURAÇÃO DO SUPABASE
============================================================

1. Crie um projeto em:
   https://supabase.com/

2. No painel do projeto, abra:
   Project Settings
   → API

3. Copie:
   Project URL
   Publishable key / anon key

4. Cole abaixo.

NUNCA coloque aqui a:
   service_role key

A service_role é secreta e não pode ser exposta no navegador.
*/


const SUPABASE_URL =
  "COLE_AQUI_A_URL_DO_SEU_PROJETO";


const SUPABASE_KEY =
  "COLE_AQUI_A_CHAVE_PUBLICA_DO_SEU_PROJETO";


/*
============================================================
CLIENTE
============================================================
*/

const supabaseClient =
  window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
  );


/*
============================================================
ELEMENTOS
============================================================
*/

const authCard =
  document.getElementById("authCard");

const userScreen =
  document.getElementById("userScreen");

const registerForm =
  document.getElementById("registerForm");

const loginForm =
  document.getElementById("loginForm");

const message =
  document.getElementById("message");


/*
============================================================
MODO LOGIN / CADASTRO
============================================================
*/

function showAuthMode(mode) {

  clearMessage();


  const registerTab =
    document.getElementById("registerTab");

  const loginTab =
    document.getElementById("loginTab");


  if (mode === "register") {

    registerForm.classList.remove("hidden");
    loginForm.classList.add("hidden");

    registerTab.classList.add("active");
    loginTab.classList.remove("active");

  } else {

    registerForm.classList.add("hidden");
    loginForm.classList.remove("hidden");

    registerTab.classList.remove("active");
    loginTab.classList.add("active");

  }

}


/*
============================================================
CADASTRO
============================================================
*/

async function register(event) {

  event.preventDefault();

  clearMessage();


  const name =
    document
      .getElementById("registerName")
      .value
      .trim();


  const email =
    document
      .getElementById("registerEmail")
      .value
      .trim();


  const password =
    document
      .getElementById("registerPassword")
      .value;


  const passwordConfirm =
    document
      .getElementById("registerPasswordConfirm")
      .value;


  const terms =
    document
      .getElementById("terms")
      .checked;


  /*
    Validações locais
  */

  if (name.length < 2) {

    showMessage(
      "Digite um nome ou apelido válido.",
      "error"
    );

    return;
  }


  if (password.length < 8) {

    showMessage(
      "A senha precisa ter pelo menos 8 caracteres.",
      "error"
    );

    return;
  }


  if (password !== passwordConfirm) {

    showMessage(
      "As senhas não são iguais.",
      "error"
    );

    return;
  }


  if (!terms) {

    showMessage(
      "Você precisa aceitar os termos para continuar.",
      "error"
    );

    return;
  }


  const button =
    document.getElementById("registerButton");


  button.disabled = true;

  button.textContent =
    "Criando conta...";


  try {

    /*
      Cria o usuário no Supabase Auth.

      O nome é colocado nos metadados do usuário.
    */

    const {
      data,
      error
    } =
      await supabaseClient.auth.signUp({

        email,

        password,

        options: {

          data: {
            display_name: name
          }

        }

      });


    if (error) {
      throw error;
    }


    /*
      Se a confirmação de e-mail estiver
      habilitada no Supabase, data.session
      poderá ser null.

      Nesse caso o usuário precisa confirmar
      o e-mail antes de entrar.
    */

    if (!data.session) {

      showMessage(
        "Conta criada. Verifique seu e-mail para confirmar a conta antes de entrar.",
        "success"
      );

      registerForm.reset();

      return;
    }


    /*
      Se confirmação de e-mail estiver
      desabilitada, o usuário já estará logado.
    */

    await createProfile(
      data.user,
      name
    );


    showLoggedUser(
      data.user
    );


  } catch (error) {

    console.error(error);

    showMessage(
      translateSupabaseError(error),
      "error"
    );

  } finally {

    button.disabled = false;

    button.textContent =
      "Criar minha conta";

  }

}


/*
============================================================
CRIAR PROFILE
============================================================

A tabela profiles será criada no Supabase.

Estrutura:

profiles
-------------------------
id
display_name
created_at
*/

async function createProfile(
  user,
  displayName
) {

  if (!user) {
    return;
  }


  const {
    error
  } =
    await supabaseClient
      .from("profiles")
      .upsert({

        id: user.id,

        display_name: displayName

      });


  if (error) {

    console.error(
      "Erro ao criar profile:",
      error
    );

    /*
      Não derrubamos a autenticação
      se o perfil falhar.

      O usuário continua autenticado.
    */

  }

}


/*
============================================================
LOGIN
============================================================
*/

async function login(event) {

  event.preventDefault();

  clearMessage();


  const email =
    document
      .getElementById("loginEmail")
      .value
      .trim();


  const password =
    document
      .getElementById("loginPassword")
      .value;


  const button =
    document.getElementById("loginButton");


  button.disabled = true;

  button.textContent =
    "Entrando...";


  try {

    const {
      data,
      error
    } =
      await supabaseClient.auth.signInWithPassword({

        email,

        password

      });


    if (error) {
      throw error;
    }


    showLoggedUser(
      data.user
    );


  } catch (error) {

    console.error(error);

    showMessage(
      translateSupabaseError(error),
      "error"
    );

  } finally {

    button.disabled = false;

    button.textContent =
      "Entrar";

  }

}


/*
============================================================
MOSTRAR USUÁRIO LOGADO
============================================================
*/

async function showLoggedUser(user) {

  if (!user) {
    return;
  }


  let displayName =
    user.user_metadata
      ?.display_name;


  /*
    Tentamos recuperar o nome
    do perfil no banco.
  */

  const {
    data: profile
  } =
    await supabaseClient
      .from("profiles")
      .select("display_name")
      .eq("id", user.id)
      .maybeSingle();


  if (
    profile &&
    profile.display_name
  ) {

    displayName =
      profile.display_name;

  }


  document.getElementById("loggedUser")
    .textContent =
      `${displayName || "Usuário"}, sua conta está conectada como ${user.email}.`;


  authCard.style.display =
    "none";

  userScreen.classList.add("active");

}


/*
============================================================
LOGOUT
============================================================
*/

async function logout() {

  const {
    error
  } =
    await supabaseClient.auth.signOut();


  if (error) {

    showMessage(
      error.message,
      "error"
    );

    return;
  }


  userScreen.classList.remove("active");

  authCard.style.display =
    "block";


  showAuthMode("login");

  document
    .getElementById("loginForm")
    .reset();

}


/*
============================================================
SESSÃO
============================================================
*/

async function checkSession() {

  const {
    data
  } =
    await supabaseClient.auth.getSession();


  if (
    data &&
    data.session &&
    data.session.user
  ) {

    showLoggedUser(
      data.session.user
    );

  }

}


/*
============================================================
MONITORAMENTO DA SESSÃO
============================================================
*/

supabaseClient.auth.onAuthStateChange(
  async (event, session) => {

    console.log(
      "Auth:",
      event
    );

    if (
      event === "SIGNED_IN" &&
      session
    ) {

      /*
        A interface já é atualizada pelo
        fluxo de login/cadastro.
      */

    }

  }
);


/*
============================================================
MENSAGENS
============================================================
*/

function showMessage(
  text,
  type
) {

  message.textContent =
    text;

  message.className =
    "message " + type;

}


function clearMessage() {

  message.textContent =
    "";

  message.className =
    "message";

}


/*
============================================================
TRADUÇÃO DE ERROS
============================================================
*/

function translateSupabaseError(error) {

  const text =
    String(
      error?.message || ""
    ).toLowerCase();


  if (
    text.includes("user already registered")
  ) {

    return "Este e-mail já possui uma conta.";

  }


  if (
    text.includes("invalid login credentials")
  ) {

    return "E-mail ou senha incorretos.";

  }


  if (
    text.includes("password should be at least")
  ) {

    return "A senha não atende aos requisitos mínimos.";

  }


  if (
    text.includes("email not confirmed")
  ) {

    return "Confirme seu e-mail antes de entrar.";

  }


  return (
    error?.message ||
    "Não foi possível concluir a operação."
  );

}


/*
============================================================
INICIALIZAÇÃO
============================================================
*/

checkSession();

</script>

</body>
</html>
