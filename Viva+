  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root {
      --primary: #087f6e;
      --primary-dark: #056456;
      --primary-light: #e7f5f2;

      --background: #f5f8f7;
      --surface: #ffffff;

      --text: #17211f;
      --muted: #697671;

      --border: #dce5e2;

      --danger: #b84c4c;
      --success: #287c59;

      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;

      font-family:
        Inter,
        system-ui,
